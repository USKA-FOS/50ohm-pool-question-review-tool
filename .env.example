# Copy this file to .env and replace every placeholder.
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_OWNER=isqsoft
GITHUB_REPO=50ohm-question-review-campaigns
# Public route id -> Git branch. Keep this JSON on one line in an env file.
CAMPAIGNS_JSON={"receiver-signals":{"branch":"campaign/multilingual-empfaenger-sinus-signals-example","label":"Receiver and sinusoidal signals"}}
DEFAULT_CAMPAIGN=receiver-signals
# Legacy single-campaign alternative when CAMPAIGNS_JSON is not set:
# CAMPAIGN_BRANCH=campaign/multilingual-empfaenger-sinus-signals-example
GITHUB_CALLBACK_URL=http://localhost:8080/auth/callback
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_secret
SESSION_HTTPS_ONLY=false
# Log individual GitHub calls and one aggregate profile per HTTP request.
GITHUB_PROFILE=false
# Maximum age of the in-memory branch snapshot before checking the remote head.
CAMPAIGN_REFRESH_SECONDS=30
