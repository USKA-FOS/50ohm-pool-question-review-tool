# Insert into the existing HTTPS server block for 50ohm.uska.ch,
# before location /. The server's Basic authentication remains inherited.
location = /isq/qrt {
    return 308 /isq/qrt/;
}

location ^~ /isq/qrt/ {
    proxy_pass http://127.0.0.1:18082/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /isq/qrt;
}
